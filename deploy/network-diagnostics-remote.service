[Unit]
Description=Network diagnostics TCP and UDP companion
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/network-diagnostics
EnvironmentFile=/etc/network-diagnostics/remote.env
ExecStart=/usr/bin/python3 -B -u -m netdiag.remote --bind 0.0.0.0 --port 48123
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
KillSignal=SIGINT
TimeoutStopSec=15s
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitCORE=0
UMask=0077

[Install]
WantedBy=multi-user.target
